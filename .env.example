# Configuración de Base de Datos PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=facturacion
DB_USER=facturador
DB_PASSWORD=tu_password_segura_aqui

# Entorno de la Aplicación (development | testing | production)
APP_ENV=development

# Clave Secreta para Sesiones y CSRF (mínimo 24 caracteres aleatorios)
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar_por_una_clave_secreta_aleatoria_muy_segura_de_al_menos_32_caracteres

# Configuración de Flask (solo desarrollo)
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
